    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import scipy.cluster.hierarchy as sch\n",
    "from sklearn.manifold import TSNE\n",
    "from sklearn.cluster import AgglomerativeClustering\n",
    "from matplotlib_venn import venn3\n",
    "from scipy.spatial.distance import pdist, squareform  
    "\n",
    "mlp_features = set(mlp_df.drop(columns=[\"Label\"]).columns)\n",
    "rf_features = set(rf_df.drop(columns=[\"Label\"]).columns)\n",
    "lasso_features = set(lasso_df.drop(columns=[\"Label\"]).columns)\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "venn3([mlp_features, rf_features, lasso_features], \n",
    "      set_labels=(\"MLP\", \"RF\", \"LASSO\"))\n",
    "plt.title(\"Feature Overlap (Venn Diagram)\")\n",
    "plt.show()\n",
    "\n",
    "def jaccard_clustermap(df, title=\"Clustermap\"):\n",
    "    features = df.drop(columns=[\"Label\"]).astype(int)  
    "    features_T = features.T  # Transpose: feature x sample\n",
    "\n",
    "    row_dist = squareform(pdist(features_T, metric='jaccard'))    # features 간\n",
    "    col_dist = squareform(pdist(features_T.T, metric='jaccard'))  # samples 간\n",
    "\n",
    "    linkage_row = sch.linkage(row_dist, method='average')\n",
    "    linkage_col = sch.linkage(col_dist, method='average')\n",
    "\n",
    "    sns.clustermap(\n",
    "        data=features_T,\n",
    "        row_linkage=linkage_row,\n",
    "        col_linkage=linkage_col,\n",
    "        cmap=\"rocket\",\n",
    "        figsize=(12, 10)\n",
    "    )\n",
    "    plt.suptitle(title, fontsize=14, y=1.02)\n",
    "    plt.show()\n",
    "\n",
    "jaccard_clustermap(mlp_df, title=\"MLP Feature Clustermap\")\n",
    "jaccard_clustermap(rf_df, title=\"RF Feature Clustermap\")\n",
    "jaccard_clustermap(lasso_df, title=\"LASSO Feature Clustermap\")\n",
    "\n",
    "def tsne_clustering_jaccard(df, true_labels, title=\"t-SNE Plot\"):\n",
    "    features = df.drop(columns=[\"Label\"]).astype(int)\n",
    "    features_T = features.T\n",
    "    sample_names = features_T.columns.tolist()\n",
    "\n",
    "    col_dist = squareform(pdist(features_T.T, metric='jaccard'))\n",
    "\n",
    "    cluster_model = AgglomerativeClustering(\n",
    "        n_clusters=len(np.unique(true_labels)),\n",
    "        linkage='average',\n",
    "        metric='precomputed'\n",
    "    )\n",
    "    cluster_labels = cluster_model.fit_predict(col_dist)\n",
    "\n",
    "    # t-SNE\n",
    "    tsne = TSNE(n_components=2, perplexity=5, random_state=42, metric='precomputed', init='random')\n",
    "    tsne_coords = tsne.fit_transform(col_dist)\n",
    "\n",
    "    tsne_df = pd.DataFrame(tsne_coords, columns=[\"TSNE-1\", \"TSNE-2\"])\n",
    "    tsne_df[\"Sample\"] = sample_names\n",
    "    tsne_df[\"Label\"] = true_labels\n",
    "    tsne_df[\"Cluster\"] = cluster_labels.astype(str)\n",
    "\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    sns.scatterplot(data=tsne_df, x=\"TSNE-1\", y=\"TSNE-2\",\n",
    "                    hue=\"Label\", style=\"Cluster\", palette=\"tab10\", s=100)\n",
    "\n",
    "    for i, row in tsne_df.iterrows():\n",
    "        plt.text(row[\"TSNE-1\"] + 0.5, row[\"TSNE-2\"] + 0.5, row[\"Sample\"], fontsize=9)\n",
    "\n",
    "    plt.title(title)\n",
    "    plt.tight_layout()\n",
    "    plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "    plt.show()\n",
    "\n",
    "tsne_clustering_jaccard(mlp_df, true_labels, title=\"MLP t-SNE\")\n",
    "tsne_clustering_jaccard(rf_df, true_labels, title=\"RF t-SNE\")\n",
    "tsne_clustering_jaccard(lasso_df, true_labels, title=\"LASSO t-SNE\")\n",
    "\n",
    "print(\"✅ 모든 작업 완료\")"
   ]
