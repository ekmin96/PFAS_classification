    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import scipy.cluster.hierarchy as sch\n",
    "from sklearn.manifold import TSNE\n",
    "from sklearn.metrics import silhouette_score, adjusted_rand_score\n",
    "from sklearn.cluster import AgglomerativeClustering\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "from scipy.spatial.distance import pdist, squareform\n",
    "\n",
    "import_dir = r\"C:\\Users\\meg57\\OneDrive\\바탕 화면\\은기\\진행중\\PFAS_transcriptomics_read-across\\classification\\Final\"\n",
    "\n",
    "excel_files = [f for f in os.listdir(import_dir) if f.endswith(\"SelectedFeatures.xlsx\")]\n",
    "\n",
    "label_path = os.path.join(import_dir, \"label.xlsx\")\n",
    "label_df = pd.read_excel(label_path, index_col=0)\n",
    "label_dict = label_df.iloc[:, 0].to_dict()\n",
    "le = LabelEncoder()\n",
    "true_labels = le.fit_transform(label_df.iloc[:, 0])\n",
    "\n",
    "summary_list = []\n",
    "\n",
    "for file in excel_files:\n",
    "    print(f\"\\n📂 Processing: {file}\")\n",
    "    file_path = os.path.join(import_dir, file)\n",
    "    df = pd.read_excel(file_path, index_col=0)\n",
    "\n",
    "    # 🎯 Feature matrix, Label\n",
    "    X = df.drop(columns=['Label']) if 'Label' in df.columns else df.copy()\n",
    "    sample_labels = label_df.loc[X.index, label_df.columns[0]]\n",
    "    y_true = le.transform(sample_labels)\n",
    "    sample_names = X.index.tolist()\n",
    "\n",
    "    # 🧬 Jaccard distance 계산 (binary 데이터)\n",
    "    X = X.astype(int)\n",
    "    jaccard_dist = squareform(pdist(X, metric='jaccard'))\n",
    "\n",
    "    # 🌿 Dendrogram\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    linkage_matrix = sch.linkage(jaccard_dist, method='average')\n",
    "    dendro = sch.dendrogram(linkage_matrix, labels=sample_names, leaf_rotation=90)\n",
    "    plt.title(f\"[Dendrogram] Jaccard Distance - {file}\")\n",
    "    plt.ylabel(\"Jaccard Distance\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # 🔗 Agglomerative Clustering\n",
    "    cluster_model = AgglomerativeClustering(\n",
    "        n_clusters=len(np.unique(y_true)),\n",
    "        linkage='average',\n",
    "        metric='precomputed'\n",
    "    )\n",
    "    cluster_labels = cluster_model.fit_predict(jaccard_dist)\n",
    "\n",
    "    # 🧠 t-SNE 시각화\n",
    "    tsne = TSNE(n_components=2, perplexity=5, random_state=42, metric='precomputed', init='random')\n",
    "    tsne_coords = tsne.fit_transform(jaccard_dist)\n",
    "    tsne_df = pd.DataFrame(tsne_coords, columns=[\"TSNE-1\", \"TSNE-2\"])\n",
    "    tsne_df[\"Cluster\"] = cluster_labels\n",
    "    tsne_df[\"TrueLabel\"] = sample_labels.values\n",
    "    tsne_df[\"Sample\"] = sample_names\n",
    "\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    sns.scatterplot(data=tsne_df, x=\"TSNE-1\", y=\"TSNE-2\", hue=\"TrueLabel\", style=\"Cluster\", palette=\"tab10\", s=100)\n",
    "\n",
    "    # 샘플 이름 표시\n",
    "    for i, row in tsne_df.iterrows():\n",
    "        plt.text(row[\"TSNE-1\"] + 0.5, row[\"TSNE-2\"] + 0.5, row[\"Sample\"], fontsize=9)\n",
    "\n",
    "    plt.title(f\"[t-SNE] Cluster vs Label - {file}\")\n",
    "    plt.tight_layout()\n",
    "    plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "    plt.show()"
   ]
