    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.model_selection import StratifiedKFold, cross_val_score, cross_val_predict\n",
    "from sklearn.linear_model import LogisticRegressionCV, LogisticRegression, LinearRegression\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.neural_network import MLPClassifier\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.pipeline import make_pipeline\n",
    "from sklearn.metrics import r2_score\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "import warnings\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "data_dir = r\"C:\\Users\\meg57\\OneDrive\\바탕 화면\\은기\\진행중\\PFAS_transcriptomics_read-across\\classification\\Final\"\n",
    "file_list = [\"Chemotype_rearranged.xlsx\", \"Toxcast_rearranged.xlsx\", \"Pathway_rearranged.xlsx\"]\n",
    "label_path = os.path.join(data_dir, \"label.xlsx\")\n",
    "\n",
    "label_df = pd.read_excel(label_path, index_col=0)\n",
    "labels = label_df.iloc[:, 0]\n",
    "\n",
    "color_map = {\n",
    "    \"LR\": \"purple\",\n",
    "    \"SVM\": \"blue\",\n",
    "    \"MLP\": \"green\",\n",
    "    \"RF\": \"orange\",\n",
    "    \"LASSO\": \"red\"\n",
    "}\n",
    "\n",
    "for file in file_list:\n",
    "    file_path = os.path.join(data_dir, file)\n",
    "    df_raw = pd.read_excel(file_path, index_col=0)\n",
    "    df = df_raw.T\n",
    "    df[\"Label\"] = labels.loc[df.index]\n",
    "\n",
    "    X = df.drop(columns=[\"Label\"])\n",
    "    y = df[\"Label\"]\n",
    "    le = LabelEncoder()\n",
    "    y_encoded = le.fit_transform(y)\n",
    "\n",
    "    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "    r2_scores = {}\n",
    "    for col in X.columns:\n",
    "        model = LinearRegression()\n",
    "        model.fit(X[[col]], y_encoded)\n",
    "        y_pred = model.predict(X[[col]])\n",
    "        r2 = r2_score(y_encoded, y_pred)\n",
    "        if r2 > 0.4:\n",
    "            r2_scores[col] = r2\n",
    "    lr_ranked = sorted(r2_scores.items(), key=lambda x: x[1], reverse=True)\n",
    "    lr_features = [f[0] for f in lr_ranked]\n",
    "\n",
    "    svm = LinearSVC(C=0.5, penalty='l1', dual=False, random_state=42, max_iter=5000)\n",
    "    svm.fit(X, y_encoded)\n",
    "    weights = np.abs(svm.coef_).sum(axis=0)  # shape: (n_features,)\n",
    "    svm_features = X.columns[weights > 0].tolist()\n",
    "\n",
    "    mlp = MLPClassifier(random_state=42, max_iter=1000)\n",
    "    mlp.fit(X, y_encoded)\n",
    "    mlp_importance = np.abs(mlp.coefs_[0]).sum(axis=1)\n",
    "    mlp_features = X.columns[mlp_importance > 0].tolist()\n",
    "    mlp_sorted = [x for _, x in sorted(zip(mlp_importance, mlp_features), reverse=True)]\n",
    "\n",
    "    rf = RandomForestClassifier(random_state=42)\n",
    "    rf.fit(X, y_encoded)\n",
    "    rf_rank = np.argsort(rf.feature_importances_)[::-1]\n",
    "    rf_features = X.columns[rf_rank[:1000]].tolist()\n",
    "\n",
    "    lasso = LogisticRegressionCV(penalty='l1', solver='liblinear', cv=cv, max_iter=1000,random_state=42)\n",
    "    lasso.fit(X, y_encoded)\n",
    "    lasso_importance = np.abs(lasso.coef_).sum(axis=0)\n",
    "    lasso_features = X.columns[lasso_importance > 1e-5]\n",
    "    lasso_sorted = [x for _, x in sorted(zip(lasso_importance[lasso_importance > 1e-5], lasso_features), reverse=True)]\n",
    "\n",
    "    model_feature_sets = {\n",
    "        \"LR\": lr_features,\n",
    "        \"SVM\": svm_features,\n",
    "        \"MLP\": mlp_sorted,\n",
    "        \"RF\": rf_features,\n",
    "        \"LASSO\": lasso_sorted\n",
    "    }\n",
    "\n",
    "    best_result = {}\n",
    "    failed_samples_dict = {}\n",
    "\n",
    "    plt.figure(figsize=(8, 5))\n",
    "    for model_name, feature_list in model_feature_sets.items():\n",
    "        means, stds = [], []\n",
    "        if len(feature_list) == 0:\n",
    "            print(f\"⚠️ {model_name}: No features selected.\")\n",
    "            continue\n",
    "\n",
    "        # 각 모델에 대해 feature set을 선택하여 cross-validation 수행\n",
    "        if model_name == \"LR\":\n",
    "            model = LogisticRegression(max_iter=3000, solver='liblinear', random_state=42)\n",
    "        elif model_name == \"SVM\":\n",
    "            model = LinearSVC(C=0.5, penalty='l1', dual=False, random_state=42, max_iter=5000)\n",
    "        elif model_name == \"MLP\":\n",
    "            model = MLPClassifier(random_state=42, max_iter=1000)\n",
    "        elif model_name == \"RF\":\n",
    "            model = RandomForestClassifier(n_estimators=100, random_state=42)\n",
    "        elif model_name == \"LASSO\":\n",
    "            model = LogisticRegressionCV(penalty='l1', solver='liblinear', cv=3, max_iter=1000, random_state=42)\n",
    "\n",
    "        for n in range(1, len(feature_list) + 1):\n",
    "            selected = feature_list[:n]\n",
    "            clf = make_pipeline(model)\n",
    "            scores = cross_val_score(clf, X[selected], y_encoded, cv=cv, scoring='accuracy')\n",
    "            means.append(scores.mean())\n",
    "            stds.append(scores.std())\n",
    "\n",
    "        best_n = np.argmax(means) + 1\n",
    "        best_score = means[best_n - 1]\n",
    "        best_std = stds[best_n - 1]\n",
    "        best_features = feature_list[:best_n]\n",
    "\n",
    "        clf_final = make_pipeline(model)\n",
    "        y_pred = cross_val_predict(clf_final, X[best_features], y_encoded, cv=cv)\n",
    "        failed_indices = df.index[y_pred != y_encoded]\n",
    "        failed_samples = failed_indices.tolist()\n",
    "        failed_samples_dict[model_name] = failed_samples\n",
    "\n",
    "        best_result[model_name] = {\n",
    "            'best_n': best_n,\n",
    "            'best_score': best_score,\n",
    "            'std': best_std,\n",
    "            'features': best_features\n",
    "        }\n",
    "\n",
    "        plt.plot(range(1, len(means)+1), means,\n",
    "                 label=model_name, color=color_map[model_name], marker='o')\n",
    "\n",
    "        print(f\"\\n📌 [{file.replace('_rearranged.xlsx','')}] - {model_name}\")\n",
    "        print(f\"✅ Best # of features: {best_n}\")\n",
    "        print(f\"✅ CV Accuracy: {best_score:.4f} ± {best_std:.4f}\")\n",
    "        print(f\"✅ Selected Features: {best_features}\")\n",
    "        print(f\"❌ Misclassified Samples: {failed_samples}\")\n",
    "\n",
    "    plt.title(f\"CV Accuracy vs. #Features ({file.replace('_rearranged.xlsx','')})\")\n",
    "    plt.xlabel(\"Number of Features\")\n",
    "    plt.ylabel(\"CV Accuracy\")\n",
    "    plt.grid(True)\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
