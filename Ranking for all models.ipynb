   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.model_selection import StratifiedKFold, cross_val_score, cross_val_predict\n",
    "from sklearn.linear_model import LogisticRegressionCV, LogisticRegression, LinearRegression\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.neural_network import MLPClassifier\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.pipeline import make_pipeline\n",
    "from sklearn.metrics import r2_score\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "import warnings\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "data_dir = r\"C:\\Users\\meg57\\OneDrive\\바탕 화면\\은기\\진행중\\PFAS_transcriptomics_read-across\\classification\\Final\"\n",
    "file_list = [\"Chemotype_rearranged_RF_SelectedFeatures.xlsx\", \"Toxcast_rearranged_SVM_SelectedFeatures.xlsx\", \"Pathway_rearranged_RF_SelectedFeatures.xlsx\"]\n",
    "label_path = os.path.join(data_dir, \"label.xlsx\")\n",
    "\n",
    "label_df = pd.read_excel(label_path, index_col=0)\n",
    "labels = label_df.iloc[:, 0]\n",
    "\n",
    "color_map = {\n",
    "    \"LR\": \"purple\",\n",
    "    \"SVM\": \"blue\",\n",
    "    \"MLP\": \"green\",\n",
    "    \"RF\": \"orange\",\n",
    "    \"LASSO\": \"red\",\n",
    "    \"PCA\": \"gray\"\n",
    "}\n",
    "\n",
    "dfs = []\n",
    "for f in file_list:\n",
    "    df = pd.read_excel(os.path.join(data_dir, f), index_col=0)\n",
    "    dfs.append(df.drop(columns='Label'))\n",
    "\n",
    "X_concat = pd.concat(dfs, axis=1)\n",
    "X_concat['Label'] = labels.loc[X_concat.index]\n",
    "\n",
    "X = X_concat.drop(columns=['Label'])\n",
    "y = X_concat['Label']\n",
    "le = LabelEncoder()\n",
    "y_encoded = le.fit_transform(y)\n",
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "results_plot = {}\n",
    "max_features = min(30, X.shape[1])\n",
    "\n",
    "r2_scores = {}\n",
    "for col in X.columns:\n",
    "    model = LinearRegression()\n",
    "    model.fit(X[[col]], y_encoded)\n",
    "    pred = model.predict(X[[col]])\n",
    "    r2 = r2_score(y_encoded, pred)\n",
    "    if r2 > 0.4:\n",
    "        r2_scores[col] = r2\n",
    "lr_ranked = sorted(r2_scores.items(), key=lambda x: x[1], reverse=True)\n",
    "lr_features = [x[0] for x in lr_ranked]\n",
    "\n",
    "svm = LinearSVC(penalty='l1', dual=False, max_iter=5000, random_state=42)\n",
    "svm.fit(X, y_encoded)\n",
    "svm_weights = np.abs(svm.coef_).sum(axis=0)\n",
    "svm_features = X.columns[svm_weights > 0].tolist()\n",
    "\n",
    "mlp = MLPClassifier(random_state=42, max_iter=1000)\n",
    "mlp.fit(X, y_encoded)\n",
    "mlp_importance = np.abs(mlp.coefs_[0]).sum(axis=1)\n",
    "mlp_features = X.columns[mlp_importance > 0]\n",
    "mlp_sorted = [x for _, x in sorted(zip(mlp_importance, mlp_features), reverse=True)]\n",
    "\n",
    "rf = RandomForestClassifier(random_state=42)\n",
    "rf.fit(X, y_encoded)\n",
    "rf_idx = np.argsort(rf.feature_importances_)[::-1][:max_features]\n",
    "rf_features = X.columns[rf_idx].tolist()\n",
    "\n",
    "lasso = LogisticRegressionCV(penalty='l1', solver='liblinear', cv=cv, max_iter=1000, random_state=42)\n",
    "lasso.fit(X, y_encoded)\n",
    "lasso_coef = np.abs(lasso.coef_).sum(axis=0)\n",
    "lasso_features = X.columns[lasso_coef > 1e-5]\n",
    "lasso_ranked = [x for _, x in sorted(zip(lasso_coef[lasso_coef > 1e-5], lasso_features), reverse=True)]\n",
    "\n",
    "pca = PCA(n_components=5, random_state=42)\n",
    "X_pca = pca.fit_transform(X)\n",
    "score_pca = cross_val_score(LogisticRegression(max_iter=1000), X_pca, y_encoded, cv=cv).mean()\n",
    "results_plot[\"PCA\"] = ([score_pca]*5, [0]*5)\n",
    "\n",
    "model_features = {\n",
    "    \"LR\": lr_features,\n",
    "    \"SVM\": svm_features,\n",
    "    \"MLP\": mlp_sorted,\n",
    "    \"RF\": rf_features,\n",
    "    \"LASSO\": lasso_ranked\n",
    "}\n",
    "\n",
    "for name, features in model_features.items():\n",
    "    means, stds = [], []\n",
    "    if len(features) == 0:\n",
    "        print(f\"⚠️ {name}: No features selected.\")\n",
    "        results_plot[name] = ([], [])\n",
    "        continue\n",
    "    for n in range(1, min(max_features, len(features)) + 1):\n",
    "        subset = features[:n]\n",
    "        clf = make_pipeline(LogisticRegression(solver='liblinear', max_iter=1000))\n",
    "        scores = cross_val_score(clf, X[subset], y_encoded, cv=cv)\n",
    "        means.append(scores.mean())\n",
    "        stds.append(scores.std())\n",
    "    results_plot[name] = (means, stds)\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "for model_name, (means, stds) in results_plot.items():\n",
    "    if len(means) == 0:\n",
    "        continue\n",
    "    plt.plot(range(1, len(means)+1), means,\n",
    "             label=model_name, color=color_map[model_name], marker='o')\n",
    "plt.xlabel(\"Number of Features\")\n",
