   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy.spatial.distance import pdist, squareform\n",
    "from scipy.cluster.hierarchy import linkage, dendrogram\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "binary_matrix = binary_df.drop(columns=[\"ID\"]).T  # Transpose: rows = samples/groups\n",
    "\n",
    "distance_matrix = pdist(binary_matrix, metric='cosine')  # 또는 'jaccard'\n",
    "linked = linkage(distance_matrix, method='ward')\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "dendrogram(linked,\n",
    "           labels=binary_matrix.index,\n",
    "           leaf_rotation=90,\n",
    "           leaf_font_size=10)\n",
    "plt.title('Clustering of RNA-seq DEG Profiles (Cosine Distance)')\n",
    "plt.xlabel('Sample/Group')\n",
    "plt.ylabel('Distance')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
