   "source": [
    "import pandas as pd\n",
    "import os\n",
    "\n",
    "file_path = r\"C:\\Users\\exm499\\Downloads\\PFAS_classification\\RNA-Seq_ZE\\DEG.xlsx\"\n",
    "\n",
    "df = pd.read_excel(file_path)\n",
    "\n",
    "all_ids = pd.unique(df.values.ravel())          
    "all_ids = [x for x in all_ids if pd.notna(x)]   # NA 제거\n",
    "\n",
    "binary_df = pd.DataFrame({\"ID\": all_ids})\n",
    "\n",
    "for col in df.columns:\n",
    "    binary_df[col] = binary_df[\"ID\"].apply(lambda x: 1 if x in df[col].values else 0)\n",
    "\n",
    "print(\"✅ 변환된 바이너리 presence/absence 매트릭스:\")\n",
    "display(binary_df.head())"
   ]
  },
